rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- HELPER FUNCTIONS ----------

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }


    // ---------- USERS ----------

    match /users/{uid} {

      // User can read own profile, admin can read all users
      allow read: if signedIn() &&
        (request.auth.uid == uid || isAdmin());

      // New user registration
      // Users can only create their own profile with customer role
      allow create: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.role == "customer";

      // User can update own profile, but cannot change role
      allow update: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.role == resource.data.role;

      // Only admin can delete users
      allow delete: if isAdmin();
    }


    // ---------- MENU ----------

    match /menu/{menuId} {

      // Everyone can view menu
      allow read: if true;

      // Only admin can manage menu
      allow create, update, delete: if isAdmin();
    }


    // ---------- ORDERS ----------

    match /orders/{orderId} {

      // Customer can create their own order
      allow create: if signedIn() &&
        request.resource.data.customerId == request.auth.uid;

      // Customer can see only own orders
      // Admin can see all orders
      allow read: if signedIn() &&
        (resource.data.customerId == request.auth.uid || isAdmin());

      // Only admin can update order status
      allow update: if isAdmin();

      // Only admin can delete orders
      allow delete: if isAdmin();
    }
  }
}